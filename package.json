{
  "name": "@f80975/viz.js",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.71.1",
  "author": "f80975 <wjnsail66@gmail.com>",
  "license": "MIT",
  "keywords": [],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vite --host",
    "lint": "eslint . --fix",
    "prepublishOnly": "nr build",
    "release": "bumpp && npm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@pmndrs/vanilla": "^1.19.1",
    "@turf/turf": "^7.0.0",
    "camera-controls": "^2.8.3",
    "d3-geo": "^3.1.1",
    "gsap": "^3.12.5",
    "idb-keyval": "^6.2.1",
    "mitt": "^3.0.1",
    "postprocessing": "^6.35.5",
    "stats.js": "^0.17.0",
    "three": "^0.164.1",
    "three-stdlib": "^2.30.0",
    "three.interactive": "^1.7.0",
    "tweakpane": "^4.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.23.0",
    "@antfu/ni": "^0.22.0",
    "@antfu/utils": "^0.7.10",
    "@tweakpane/core": "^2.0.3",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.14.11",
    "@types/stats.js": "^0.17.3",
    "@types/three": "^0.164.0",
    "bumpp": "^9.4.1",
    "eslint": "^9.7.0",
    "esno": "^4.7.0",
    "lint-staged": "^15.2.7",
    "pnpm": "^9.5.0",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.5.3",
    "unbuild": "^2.0.0",
    "vite": "^5.3.4",
    "vite-plugin-glsl": "^1.3.0",
    "vitest": "^2.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "./src/**/*.ts": "eslint --fix"
  }
}
